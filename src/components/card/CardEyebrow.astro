---
import type { Polymorphic } from "astro/types";

type EyebrowTag =
  | "div"
  | "span"
  | "p"
  | "section"
  | "time"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6";

type Props<Component extends EyebrowTag = "p"> = Polymorphic<{
  as: Component;
}> & {
  decorate?: boolean;
};

const {
  as: Component = "p",
  class: class_name,
  decorate = false,
  ...props
} = Astro.props;
---

<Component
  class:list={[
    "relative z-10 order-first mb-3 flex items-center text-sm text-zinc-500",
    decorate && "pl-3.5",
    class_name,
  ]}
  {...props}
>
  {
    decorate && (
      <span
        class="absolute inset-y-0 left-0 flex items-center"
        aria-hidden="true"
      >
        <span class="h-4 w-0.5 rounded-full bg-zinc-500" />
      </span>
    )
  }
  <slot />
</Component>
