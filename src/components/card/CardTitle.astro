---
import type { Polymorphic } from "astro/types";

import CardLink from "./CardLink.astro";

type CardTitleTag =
  | "div"
  | "span"
  | "p"
  | "section"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6";

type Props<Component extends CardTitleTag = "h2"> = Polymorphic<{
  as: Component;
}> & {
  href?: string;
};

const {
  as: Component = "h2",
  href = "",
  class: class_name,
  ...props
} = Astro.props;
---

<Component
  class:list={[
    "text-base font-semibold tracking-tight break-all text-zinc-100",
    class_name,
  ]}
  {...props}
>
  {
    href ? (
      <CardLink href={href}>
        <slot />
      </CardLink>
    ) : (
      <slot />
    )
  }
</Component>
