---
import type { Polymorphic } from "astro/types";

type CardTag =
  | "div"
  | "span"
  | "p"
  | "li"
  | "section"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6";

type Props<Component extends CardTag = "div"> = Polymorphic<{
  as: Component;
}>;

const { as: Component = "div", class: class_name, ...props } = Astro.props;
---

<Component
  class:list={["group relative flex flex-col items-start", class_name]}
  {...props}
>
  <slot />
</Component>
